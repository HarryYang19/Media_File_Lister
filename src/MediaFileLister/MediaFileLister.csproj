<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>媒体文件清单</AssemblyName>
    <RootNamespace>MediaFileLister</RootNamespace>
    <Version>1.0.0</Version>
    <Company>HarryYang19</Company>
    <Product>媒体文件清单</Product>
    <Description>本地扫描文件名并读取音频、照片、视频元数据。</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Build workflow downloads these folders before publishing. -->
  <ItemGroup>
    <Content Include="tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>tools\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
</Project>
